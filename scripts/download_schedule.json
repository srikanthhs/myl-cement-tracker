{
  "_comment": "TNRD Download Schedule. Set TNRD_SESSION_COOKIE (preferred) or TNRD_USERNAME+TNRD_PASSWORD as env vars / GitHub Secrets.",

  "credentials": {
    "_comment": "Leave blank – use environment variables instead.",
    "username": "",
    "password": ""
  },

  "login": {
    "url": "https://tnrd.tn.gov.in/project/logincheck.php?flag=1",
    "method": "POST",
    "multipart": true,
    "username_field": "uname",
    "password_field": "pwd",
    "password_hash": "md5",
    "fetch_csrf_first": false,
    "extra_fields": {},
    "success_contains": "",
    "failure_contains": "invalid"
  },

  "reports": [
    {
      "id": "cement_allotment",
      "name": "Cement Allotment Report",
      "enabled": true,
      "url": "https://tnrd.tn.gov.in/project/TODO_allotment_export_url",
      "method": "GET",
      "params": {
        "fromDate": "{today}",
        "toDate": "{today}"
      },
      "form_data": {},
      "date_format": "%d-%m-%Y",
      "sheet_name": 0,
      "header_row": 0,
      "schedule_times": ["08:00", "14:00", "20:00"],
      "firebase_collection": "tnrd_reports"
    },
    {
      "id": "cement_stock",
      "name": "Cement Stock Status",
      "enabled": true,
      "url": "https://tnrd.tn.gov.in/project/TODO_stock_export_url",
      "method": "GET",
      "params": {
        "date": "{today}"
      },
      "form_data": {},
      "date_format": "%d-%m-%Y",
      "sheet_name": 0,
      "header_row": 0,
      "schedule_times": ["09:00", "17:00"],
      "firebase_collection": "tnrd_reports"
    },
    {
      "id": "beneficiary_list",
      "name": "Beneficiary List",
      "enabled": true,
      "url": "https://tnrd.tn.gov.in/project/TODO_beneficiary_export_url",
      "method": "GET",
      "params": {},
      "form_data": {},
      "date_format": "%d-%m-%Y",
      "sheet_name": 0,
      "header_row": 0,
      "schedule_times": ["07:00"],
      "firebase_collection": "tnrd_reports"
    },
    {
      "id": "issuance_summary",
      "name": "Issuance Summary Report",
      "enabled": true,
      "url": "https://tnrd.tn.gov.in/project/TODO_issuance_export_url",
      "method": "POST",
      "params": {},
      "form_data": {
        "fromDate": "{today}",
        "toDate": "{today}"
      },
      "date_format": "%d-%m-%Y",
      "sheet_name": 0,
      "header_row": 0,
      "schedule_times": ["08:30", "13:30", "18:30"],
