      "method": "GET",
      "params": {
        "fromDate": "{today}",
        "toDate": "{today}",
        "district": "Mayiladuthurai"
      },
      "form_data": {},
      "date_format": "%d-%m-%Y",
      "sheet_name": 0,
      "header_row": 0,
      "schedule_times": ["08:00", "14:00", "20:00"],
      "firebase_collection": "tnrd_reports"
    },
    {
      "id": "cement_stock",
      "name": "Cement Stock Status",
      "enabled": true,
      "url": "https://tnrd.tn.gov.in/Reports/StockReport",
      "method": "GET",
      "params": {
        "date": "{today}",
        "district": "Mayiladuthurai"
      },
      "form_data": {},
      "date_format": "%d-%m-%Y",
      "sheet_name": 0,
      "header_row": 0,
      "schedule_times": ["09:00", "17:00"],
