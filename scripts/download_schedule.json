{
  "_comment": "TNRD Download Schedule Configuration. Credentials come from env vars (TNRD_USERNAME, TNRD_PASSWORD). Update 'url' and field names to match the actual tnrd.tn.gov.in report pages.",

  "credentials": {
    "_comment": "Leave blank — set TNRD_USERNAME and TNRD_PASSWORD as environment variables instead.",
    "username": "",
    "password": ""
  },

  "login": {
    "url": "https://tnrd.tn.gov.in/Account/Login",
    "method": "POST",
    "username_field": "UserName",
    "password_field": "Password",
    "fetch_csrf_first": true,
    "extra_fields": {},
    "success_contains": "Dashboard",
    "failure_contains": "Invalid"
  },

  "reports": [
